\par \hich\af31506\dbch\af31505\loch\f31506 function installFollowUpTrigger() \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  removeFollowUpTrigger(); // avoid duplicate triggers if run twice
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  ScriptApp.newTrigger("sendFollowUpReminders")
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ .timeBased()
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ .everyHours(12)
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ .create();
