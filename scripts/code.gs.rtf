\par \hich\af31506\dbch\af31505\loch\f31506 const RATE_LIMIT_MAX_PER_WINDOW = 3; \~ \~ \~\hich\af31506\dbch\af31505\loch\f31506 // max submissions...
\par \hich\af31506\dbch\af31505\loch\f31506 const RATE_LIMIT_WINDOW_SECONDS = 1800; \~ // ...per phone number, per 30 minutes
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 // Returns true if this phone number is still within its allowed rate,
\par \hich\af31506\dbch\af31505\loch\f31506 // and records this attempt. Returns false if it should be blocked.
\par \hich\af31506\dbch\af31505\loch\f31506 function checkRateLimit_(phone) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  const cache = CacheService.getScriptCache();
\par \~\hich\af31506\dbch\af31505\loch\f31506  const key = "rl_" + String(phone).replace(/\\D/g, ""); // digits only, so formatting differences don't create separate buckets
\par \~\hich\af31506\dbch\af31505\loch\f31506  if (!key || key === "rl_") return true; \hich\af31506\dbch\af31505\loch\f31506 // no phone provided \hich\f31506 \emdash \loch\f31506  let normal validation catch that instead
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const countStr = cache.get(key);
\par \~\hich\af31506\dbch\af31505\loch\f31506  const count = countStr ? parseInt(countStr, 10) : 0;
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  if (count >= RATE_LIMIT_MAX_PER_WINDOW) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ return false;
\par \~\hich\af31506\dbch\af31505\loch\f31506  \}
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  cache.put(key, String(count + 1), RATE_LIMIT_WINDOW_SECONDS);
\par \~\hich\af31506\dbch\af31505\loch\f31506  return true;
\par \}
