\par \hich\af31506\dbch\af31505\loch\f31506 const REMINDER_EMAIL = "lace26@gmail.com";
\par \hich\af31506\dbch\af31505\loch\f31506 const REMINDER_THRESHOLD_HOURS = 12;
\par \hich\af31506\dbch\af31505\loch\f31506 const OPEN_STATUSES = ["New", "Contacted", "Follow-up"]; \hich\af31506\dbch\af31505\loch\f31506 // not Converted/Lost
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 function sendFollowUpReminders() \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  const sheet = SpreadsheetApp
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ .openById("1EzdjUeww3jK6xBOU0opPYYxPT1F2kE38XJvq3OgwTHs")
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ .getSheetByName("Enquiries");
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const lastRow = sheet.getLastRow();
\par \~\hich\af31506\dbch\af31505\loch\f31506  if (lastRow < 2) return; // no data rows yet
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  // Columns: A Timestamp | B EnquiryID | C Name | D Mobile | E Email |
\par \~\hich\af31506\dbch\af31505\loch\f31506  // \~ \~ \~ \~ \~F Facility | G Date | H Guests | I Message | J Status | K Source
\par \~\hich\af31506\dbch\af31505\loch\f31506  const data = sheet.getRange(2, 1, lastRow - 1, 10).getValues();
\par \~\hich\af31506\dbch\af31505\loch\f31506  const now = new \hich\af31506\dbch\af31505\loch\f31506 Date();
\par \~\hich\af31506\dbch\af31505\loch\f31506  const overdue = [];
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  data.forEach(row => \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const [timestamp, enquiryId, name, mobile, , facility, , , , status] = row;
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ if (!timestamp || !status) return;
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ if (OPEN_STATUSES.indexOf(status) === -1) return;
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const ageHours = (now - new Date(timestamp)) / (1000 * 60 * 60);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ if (ageHours >= REMINDER_THRESHOLD_HOURS) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ overdue.push(\{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ \~ enquiryId: enquiryId,
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ \~ name: name,
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ \~ mobile: mobile,
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ \~ facility: facility,
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ \~ status: status,
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ \~ ageHours:\hich\af31506\dbch\af31505\loch\f31506  Math.floor(ageHours)
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ \});
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \}
\par \~\hich\af31506\dbch\af31505\loch\f31506  \});
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  if (overdue.length === 0) return; // nothing to report \hich\f31506 \emdash \loch\f31506  no email sent
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const lines = overdue.map(o =>
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ `$\{o.enquiryId\} \hich\f31506 \emdash \loch\f31506  $\{o.name\} ($\{o.mobile\}) \hich\f31506 \emdash \loch\f31506  $\{o.facility\} \hich\f31506 \emdash \loch\f31506  ` +
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ `Status: $\{o.status\} \hich\f31506 \emdash \loch\f31506  Waiting $\{o.ageHours\}h`
\par \~\hich\af31506\dbch\af31505\loch\f31506  );
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const subject = `L's Park: $\{overdue.length\} enquir$\{overdue.length === 1 ? "y needs" : "ies need"\} follow-up`;
\par \~\hich\af31506\dbch\af31505\loch\f31506  const body =
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ `The following enquiries have been open $\{REMINDER_THRESHOLD_HOURS\}+ hours ` +
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \hich\af31506\dbch\af31505\loch\f31506 `without moving to Converted or Lost:\\n\\n` +
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ lines.join("\\n") +
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ `\\n\\nOpen the Enquiries sheet to update their status:\\n` +
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ `https://docs.google.com/spreadsheets/d/1EzdjUeww3jK6xBOU0opPYYxPT1F2kE38XJvq3OgwTHs/edit`;
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  MailApp.sendEmail(REMINDER_EMAIL, subject, body);
\par \}
