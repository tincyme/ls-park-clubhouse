\par \hich\af31506\dbch\af31505\loch\f31506 function setupStatusManagement() \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  const sheet = SpreadsheetApp
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ .openById(\hich\af31506\dbch\af31505\loch\f31506 "1EzdjUeww3jK6xBOU0opPYYxPT1F2kE38XJvq3OgwTHs")
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ .getSheetByName("Enquiries");
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const statusValues = ["New", "Contacted", "Follow-up", "Converted", "Lost"];
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  // Status is column J (10th column) based on your current headers:
\par \~\hich\af31506\dbch\af31505\loch\f31506  // Timestamp | Enquiry ID | Name | Mobile | Email | Facility | Date | Guests | Message | Status
\par \~\hich\af31506\dbch\af31505\loch\f31506  const statusColumn = 10;
\par \~\hich\af31506\dbch\af31505\loch\f31506  const lastRow = Math.max(sheet.getLastRow(), 1000); // covers existing + future rows
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const range = sheet.getRange(2, statusColumn, lastRow - 1, 1);
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  // 1. Dropdown validation
\par \~\hich\af31506\dbch\af31505\loch\f31506  const rule = SpreadsheetApp.newDataValidation()
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ .requireValueInList(statusValues, true)
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ .setAllowInvalid(false)
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ .build();
\par \~\hich\af31506\dbch\af31505\loch\f31506  range.setDataValidation(rule);
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  // 2. Colour-coded conditional formatting
\par \~\hich\af31506\dbch\af31505\loch\f31506  const rules = sheet.getConditionalFormatRules();
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const colours = \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ "New": "#FFF2CC", \~ \~ \~ // pale yellow \hich\f31506 \emdash \loch\f31506  needs attention
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ "Contacted": "#D9E8FB", // pale blue \hich\f31506 \emdash \loch\f31506  in progress
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ "Follow-up": "#FCE4D6", // pale orange \hich\f31506 \emdash \loch\f31506  needs action
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ "Converted": \hich\af31506\dbch\af31505\loch\f31506 "#D9EAD3", // pale green \hich\f31506 \emdash \loch\f31506  success
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ "Lost": "#F4CCCC" \~ \~ \~ // pale red \hich\f31506 \emdash \loch\f31506  closed, no sale
\par \~\hich\af31506\dbch\af31505\loch\f31506  \};
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  Object.keys(colours).forEach(status => \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const cfRule = SpreadsheetApp.newConditionalFormatRule()
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ .whenTextEqualTo(status)
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ .setBackground(colours[status])
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ .setRanges([range])
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ .build();
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ rules.push(cfRule);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \});
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  sheet.setConditionalFormatRules(rules);
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const message =
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ "Done! Status column now has a dropdown (New / Contacted / Follow-up / " +
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \hich\af31506\dbch\af31505\loch\f31506 "Converted / Lost) with colour coding. Existing 'New' rows are unaffected.";
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  try \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ // Works only when triggered from the Sheet's UI (e.g. the custom menu).
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ SpreadsheetApp.getUi().alert(message);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \} catch (e) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ // Running directly from the Apps Script editor has no UI context \hich\f31506 \emdash 
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ // log instead so it doesn't throw.
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ Logger.log(message);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \}
\par \}
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 \hich\f31506 // \u9472\'2d\u9472\'2d\loch\f31506 \hich\f31506  Owner follow-up reminders \u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472
\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d
