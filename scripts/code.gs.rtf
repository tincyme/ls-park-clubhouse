\par \hich\af31506\dbch\af31505\loch\f31506 function installFollowUpTrigger() \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  removeFollowUpTrigger(); \hich\af31506\dbch\af31505\loch\f31506 // avoid duplicate triggers if run twice
