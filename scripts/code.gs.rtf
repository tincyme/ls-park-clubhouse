\par \hich\af31506\dbch\af31505\loch\f31506 function checkAvailability(facilityName, dateStr) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  const facilityId = FACILITY_IDS[String(facilityName).trim()];
\par \~\hich\af31506\dbch\af31505\loch\f31506  if (!facilityId) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ return \{ success: false, error:\hich\af31506\dbch\af31505\loch\f31506  "Facility not supported for online availability yet. Please enquire directly." \};
\par \~\hich\af31506\dbch\af31505\loch\f31506  \}
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const bookingsSheet = ss.getSheetByName("Bookings");
\par \~\hich\af31506\dbch\af31505\loch\f31506  const bookingsLastRow = bookingsSheet.getLastRow();
\par \~\hich\af31506\dbch\af31505\loch\f31506  const bookingRows = bookingsLastRow >= 2 ? bookingsSheet.getRange(2, 1, bookingsLastRow - 1, 14).getValues() : [];
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const blocksSheet = ss.getSheetByName("Blocked Slots");
\par \~\hich\af31506\dbch\af31505\loch\f31506  const blocksLastRow = blocksSheet.getLastRow();
\par \~\hich\af31506\dbch\af31505\loch\f31506  const blockRows = \hich\af31506\dbch\af31505\loch\f31506 blocksLastRow >= 2 ? blocksSheet.getRange(2, 1, blocksLastRow - 1, 9).getValues() : [];
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const targetDate = String(dateStr).trim();
\par \~\hich\af31506\dbch\af31505\loch\f31506  const results = \{\};
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  Object.keys(SLOT_TIMES).forEach(function (slotName) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const slotStart = SLOT_TIMES[slotName].start;
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const slotEnd = SLOT_TIMES[slotName].end;
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const slotStartMin = timeToMinutes_(slotStart);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const slotEndMin = timeToMinutes_(slotEnd);
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const isBooked = bookingRows.some(function (row) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rFacilityId = String(row[3]).\hich\af31506\dbch\af31505\loch\f31506 trim(); \~ \~ \~ \~ \~// Facility ID
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rDate = normalizeDateStr_(row[5]); \~ \~ \~ \~ \~ \~ // Booking Date
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rStart = normalizeTimeStr_(row[6]); \~ \~ \~ \~ \~ \~// Start Time
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rEnd = normalizeTimeStr_(row[7]); \~ \~ \~ \~ \~ \~ \~// End Time
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rStatus = String(row[10]).trim(); \~ \~ \~ \~ \~ \~ \~// Status
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ return rFacilityId === facilityId &&
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ \~ \~ \~ \~rDate === targetDate &&
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ \~ \~ \~ \~rStart === slotStart &&
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ \~ \~ \~ \~rEnd === slotEnd &&
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ \~ \~ \~ \~rStatus === "Confirmed";
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~\hich\af31506\dbch\af31505\loch\f31506  \});
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const isBlocked = !isBooked && blockRows.some(function (row) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rFacilityId = String(row[1]).trim(); \~// Facility ID
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rDate = normalizeDateStr_(row[3]); \~ \~ // Block Date
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rStatus = String(row[7]).trim(); \~ \~ \~ // Status
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ if (rFacilityId !== facilityId || rDate !== targetDate || rStatus !== "Active") return false;
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ // Overlap check \hich\f31506 \emdash \loch\f31506  a block only needs to touch part of the slot to
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ \hich\af31506\dbch\af31505\loch\f31506 // make the whole slot unavailable (e.g. 2-hour maintenance block
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ // inside a 6-hour Morning slot).
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rStartMin = timeToMinutes_(normalizeTimeStr_(row[4]));
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rEndMin = timeToMinutes_(normalizeTimeStr_(row[5]));
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ return rStartMin < slotEndMin && rEndMin > slotStartMin;
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \});
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ results[slotName] = isBooked ? "Booked" : (isBlocked ? "Blocked" : "Available");
\par \~\hich\af31506\dbch\af31505\loch\f31506  \});
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  return \{ success: true, slots: results \};
\par \}
\par 
