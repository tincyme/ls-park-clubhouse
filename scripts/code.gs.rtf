\par \hich\af31506\dbch\af31505\loch\f31506 function checkFixedSlotAvailability(facilityName, dateStr) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  const facilityId = FACILITY_IDS[String(facilityName).trim()];
