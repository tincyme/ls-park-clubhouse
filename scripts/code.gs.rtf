\par \hich\af31506\dbch\af31505\loch\f31506 // Checks actual remaining Pool capacity for every hour spanned by
\par \hich\af31506\dbch\af31505\loch\f31506 // [startTime, endTime) on the given date, using a FRESH read of the
\par \hich\af31506\dbch\af31505\loch\f31506 // Bookings sheet (never cached), since this must be correct at both
\par \hich\af31506\dbch\af31505\loch\f31506 // booking-request time and again at approval time \hich\f31506 \emdash \loch\f31506  capacity can
\par \hich\af31506\dbch\af31505\loch\f31506 // change between those two moments as other requests get approved.
\par \hich\af31506\dbch\af31505\loch\f31506 // Returns \{ minRemaining, hasExclusive, worstHour \}.
\par \hich\af31506\dbch\af31505\loch\f31506 function checkPoolCapacityForRange_(dateStr, startTime, endTime) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  const targetDate = String(dateStr).trim();
\par \~\hich\af31506\dbch\af31505\loch\f31506  const\hich\af31506\dbch\af31505\loch\f31506  rangeStartMin = timeToMinutes_(startTime);
\par \~\hich\af31506\dbch\af31505\loch\f31506  const rangeEndMin = timeToMinutes_(endTime);
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const bookingsSheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName("Bookings");
\par \~\hich\af31506\dbch\af31505\loch\f31506  const lastRow = bookingsSheet.getLastRow();
\par \~\hich\af31506\dbch\af31505\loch\f31506  const bookingRows = lastRow >= 2 ? bookingsSheet.getRange(2, 1, lastRow - 1, 14).getValues() : [];
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  const hourlySlots = generateHourlySlots_("Swimming Pool").filter(function (slot) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const slotStartMin = timeToMinutes_(slot.start);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const slotEndMin = timeToMinutes_(\hich\af31506\dbch\af31505\loch\f31506 slot.end);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ return slotStartMin < rangeEndMin && slotEndMin > rangeStartMin; // overlaps the requested range
\par \~\hich\af31506\dbch\af31505\loch\f31506  \});
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  let minRemaining = POOL_MAX_CAPACITY;
\par \~\hich\af31506\dbch\af31505\loch\f31506  let hasExclusive = false;
\par \~\hich\af31506\dbch\af31505\loch\f31506  let worstHour = "";
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  hourlySlots.forEach(function (slot) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const slotStartMin = timeToMinutes_(slot.start);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const slotEndMin = timeToMinutes_(slot.end);
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const overlapping = bookingRows.filter(function (row) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rFacilityId = String(row[3]).trim();
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rDate = normalizeDateStr_(row[5]);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rStart = normalizeTimeStr_(row[6]);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rEnd = normalizeTimeStr_(row[7]);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rStatus = String(row[10]).trim();
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ if (rFacilityId !== "F001" || rDate !== targetDate || rStatus !== "Confirmed") return false;
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rStartMin = timeToMinutes_(rStart);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ const rEndMin = timeToMinutes_(rEnd);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ return rStartMin < slotEndMin && rEndMin > slotStartMin;
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \});
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const exclusiveHere = overlapping.some(function (row) \{ return String(row[8]).trim() === "Exclusive"\hich\af31506\dbch\af31505\loch\f31506 ; \});
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const sharedGuests = overlapping
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ .filter(function (row) \{ return String(row[8]).trim() !== "Exclusive"; \})
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ .reduce(function (sum, row) \{ return sum + (Number(row[9]) || 0); \}, 0);
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const remainingHere = exclusiveHere ? 0 : (POOL_MAX_CAPACITY - sharedGuests);
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ if (exclusiveHere) hasExclusive = true;
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ if (remainingHere < minRemaining) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ minRemaining = remainingHere;
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \~ worstHour = slot.start + "\hich\f31506 \endash \loch\f31506 " + slot.end;
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ \}
\par \~\hich\af31506\dbch\af31505\loch\f31506  \});
\par 
\par \~\hich\af31506\dbch\af31505\loch\f31506  return \{ minRemaining: Math.max(\hich\af31506\dbch\af31505\loch\f31506 minRemaining, 0), hasExclusive: hasExclusive, worstHour: worstHour \};
\par \}
\par 
