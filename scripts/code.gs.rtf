\par \~\hich\af31506\dbch\af31505\loch\f31506  const message = \hich\af31506\dbch\af31505\loch\f31506 "Reminder trigger installed \hich\f31506 \emdash \loch\f31506  checking every 12 hours for enquiries open 12+ hours.";
\par \~\hich\af31506\dbch\af31505\loch\f31506  try \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ SpreadsheetApp.getUi().alert(message);
