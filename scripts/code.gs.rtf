\par \hich\af31506\dbch\af31505\loch\f31506 // Per-facility operating windows. Badminton has member-reserved slots
\par \hich\af31506\dbch\af31505\loch\f31506 // as early as 5 AM and as late as 11 PM, so it needs a wider window than
\par \hich\af31506\dbch\af31505\loch\f31506 // the Pool.
\par \hich\af31506\dbch\af31505\loch\f31506 const \hich\af31506\dbch\af31505\loch\f31506 FACILITY_OPERATING_HOURS = \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  "Swimming Pool": \{ start: 6, end: 20 \}, \~ // 6 AM \hich\f31506 \endash \loch\f31506  8 PM
\par \~\hich\af31506\dbch\af31505\loch\f31506  "Badminton": \{ start: 5, end: 23 \} \~ \~ \~ \~// 5 AM \hich\f31506 \endash \loch\f31506  11 PM
\par \}\hich\af31506\dbch\af31505\loch\f31506 ;
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 function generateHourlySlots_(facilityName) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  const hours = FACILITY_OPERATING_HOURS[facilityName] || \{ start: 6, end: 20 \};
\par \~\hich\af31506\dbch\af31505\loch\f31506  const slots = [];
\par \~\hich\af31506\dbch\af31505\loch\f31506  for (let h = hours.start; h < hours.end; h++) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const start = (h < 10 ? "0" + h : h) + ":00";
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const endHour = h + 1;
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const end = (endHour < 10 ? "0" + endHour : endHour) + ":00";
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ slots.push(\{ \hich\af31506\dbch\af31505\loch\f31506 start: start, end: end \});
\par \~\hich\af31506\dbch\af31505\loch\f31506  \}
\par \~\hich\af31506\dbch\af31505\loch\f31506  return slots;
\par \}
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 function timeToMinutes_(hhmm) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  const parts = String(hhmm).split(":");
\par \~\hich\af31506\dbch\af31505\loch\f31506  const hours = parseInt(parts[0], 10) || 0;
\par \~\hich\af31506\dbch\af31505\loch\f31506  const minutes = parseInt(parts[1], 10) || 0;
\par \~\hich\af31506\dbch\af31505\loch\f31506  return (hours * 60) + minutes;
\par \}
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 function normalizeDateStr_(value) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  if (!value) return "";
\par \~\hich\af31506\dbch\af31505\loch\f31506  if (value instanceof Date) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ return Utilities.formatDate(value, Session.getScriptTimeZone(), "yyyy-MM-dd");
\par \~\hich\af31506\dbch\af31505\loch\f31506  \}
\par \~\hich\af31506\dbch\af31505\loch\f31506  // Plain text (our guaranteed format going forward) \hich\f31506 \emdash \loch\f31506  trust it as-is,
\par \~\hich\af31506\dbch\af31505\loch\f31506  \hich\af31506\dbch\af31505\loch\f31506 // no Date parsing, no timezone conversion, no ambiguity.
\par \~\hich\af31506\dbch\af31505\loch\f31506  return String(value).trim();
\par \}
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 function normalizeTimeStr_(value) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  if (!value) return "";
\par \~\hich\af31506\dbch\af31505\loch\f31506  if (value instanceof Date) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ return Utilities.formatDate(value, Session.getScriptTimeZone(), "HH:mm");
\par \~\hich\af31506\dbch\af31505\loch\f31506  \}
\par \~\hich\af31506\dbch\af31505\loch\f31506  return String(value).trim();
\par \}
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 // Appends a row, then force-formats specific columns (1-based indexes) as
\par \hich\af31506\dbch\af31505\loch\f31506 // plain text and re-writes their values as literal strings. This prevents
\par \hich\af31506\dbch\af31505\loch\f31506 // Google Sheets from silently auto-converting date/time-looking strings
\par \hich\af31506\dbch\af31505\loch\f31506 // into its internal date/time type, which caused availability checks to
\par \hich\af31506\dbch\af31505\loch\f31506 // mismatch due to timezone conversion differences between the Spreadsheet
\par \hich\af31506\dbch\af31505\loch\f31506 // and Apps Script project settings.
\par \hich\af31506\dbch\af31505\loch\f31506 function appendRowSafely_(sheet, values, textColumnIndexes) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  sheet.appendRow(values);
\par \~\hich\af31506\dbch\af31505\loch\f31506  const newRow = sheet.getLastRow();
\par \~\hich\af31506\dbch\af31505\loch\f31506  textColumnIndexes.forEach(function (colIndex) \{
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ const cell = sheet.getRange(newRow, colIndex);
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ cell.setNumberFormat(\hich\af31506\dbch\af31505\loch\f31506 "@");
\par \~\hich\af31506\dbch\af31505\loch\f31506  \~ cell.setValue(String(values[colIndex - 1]));
\par \~\hich\af31506\dbch\af31505\loch\f31506  \});
\par \~\hich\af31506\dbch\af31505\loch\f31506  return newRow;
\par \}
\par 
\par \hich\af31506\dbch\af31505\loch\f31506 \hich\f31506 // \u9472\'2d\u9472\'2d\loch\f31506 \hich\f31506  Availability check (used by doGet) \u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472
\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d\u9472\'2d
